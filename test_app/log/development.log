196:                          <div class="w-14 h-7 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-green-400 peer-checked:to-blue-500"></div>
197:                          <span class="ml-3 text-sm font-medium text-gray-700">
198:                            <%= @component_props[key] ? "Enabled" : "Disabled" %>
199:                          </span>
200:                        </label>
201:                      <% end %>
