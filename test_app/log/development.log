end %&gt;</code></pre>
            </div>
          </div>
        </div>
        
        <!-- Component Source Info -->
        <div class="bg-white rounded-lg shadow-md p-8 mt-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Component Definition</h2>
          <div class="text-sm text-gray-700">
