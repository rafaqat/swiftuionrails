*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

# Used by dotenv library to load environment variables.
.env
.env.*
!.env.example
!.env.test

# Ignore Byebug command history file.
.byebug_history

## Specific to RubyMotion:
.dat*
.repl_history
build/
*.bridgesupport
build-iPhoneOS/
build-iPhoneSimulator/

## Specific to RubyMotion (use of CocoaPods):
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# vendor/Pods/

## Documentation cache and generated files:
/.yardoc/
/_yardoc/
/doc/
/rdoc/

## Environment normalization:
/.bundle/
/vendor/bundle
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
Gemfile.lock
.ruby-version
.ruby-gemset

# The embedded Rails application is the executable test harness. Keep its
# runtime and dependency graph reproducible in clean checkouts and CI.
!test_app/Gemfile.lock
!test_app/.ruby-version

# Runtime-only output from the embedded Rails test application.
/test_app/tmp/*
!/test_app/tmp/.keep
!/test_app/tmp/pids/
/test_app/tmp/pids/*
!/test_app/tmp/pids/.keep
!/test_app/tmp/storage/
/test_app/tmp/storage/*
!/test_app/tmp/storage/.keep
/test_app/tmp/local_secret.txt
/test_app/coverage/
/test_app/brakeman-report.json
/test_app/brakeman-report.html

# Stray browser-automation captures from MCP tooling.
.playwright-mcp/

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc

# Used by RuboCop. Remote config files pulled in from inherit_from directive.
# .rubocop-https?--*
# Rails runtime noise
/log/
/tmp/
*.pid
*.log

# Security: Never commit secrets
config/master.key
test_app/config/master.key
config/credentials/*.key
.env
.env.*
*.pem
*.key
/test_app/log/*
!/test_app/log/.keep
