<% content_for :title, "Register Dialog Component Test" %>

<!-- Test page for RegisterDialogComponent -->
<div class="max-w-4xl mx-auto p-6 space-y-8">
  
  <!-- Test Controls -->
  <div class="bg-white rounded-lg border p-6">
    <h2 class="text-xl font-semibold mb-4">Register Dialog Test Controls</h2>
    <div class="flex flex-wrap gap-4">
      <button id="open-register-btn" 
              class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
        Open Register Dialog
      </button>
      <button id="open-register-with-errors-btn"
              class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
        Open with Validation Errors
      </button>
      <button id="open-register-with-data-btn"
              class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
        Open with Pre-filled Data
      </button>
    </div>
  </div>

  <!-- Register Dialog Component -->
  <%= render SwiftUIRails::Component::Composed::Auth::RegisterDialogComponent.new(
    open: @show_register || false,
    register_url: auth_test_register_submit_path,
    login_url: auth_test_login_path,
    close_url: auth_test_register_path,
    show_social: @show_social.nil? ? true : @show_social,
    social_providers: ['google', 'github'],
    errors: @errors,
    form_data: @form_data
  ) %>

  <!-- Test Information Panel -->
  <div class="bg-gray-50 rounded-lg p-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Register Dialog Component Test</h2>
    
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <h3 class="font-medium text-gray-900 mb-2">Component Details:</h3>
        <code class="text-sm text-gray-700 block bg-white p-3 rounded border">
          SwiftUIRails::Component::Composed::Auth::RegisterDialogComponent
        </code>
        
        <h3 class="font-medium text-gray-900 mb-2 mt-4">Test Scenarios:</h3>
        <ul class="text-sm text-gray-700 space-y-1">
          <li>• Modal open/close behavior</li>
          <li>• Form validation (empty fields, password mismatch)</li>
          <li>• Password strength checking</li>
          <li>• Email uniqueness validation</li>
          <li>• Terms of service acceptance</li>
          <li>• Successful registration flow</li>
          <li>• Error message display</li>
          <li>• Social registration integration</li>
          <li>• Responsive design</li>
          <li>• Keyboard accessibility</li>
        </ul>
      </div>
      
      <div>
        <h3 class="font-medium text-gray-900 mb-2">Test Data:</h3>
        <div class="text-sm text-gray-700 space-y-2">
          <div class="bg-white p-3 rounded border">
            <strong>Valid Registration:</strong><br>
            First Name: John<br>
            Last Name: Doe<br>
            Email: new@example.com<br>
            Password: SecurePass123!<br>
            Confirm: SecurePass123!<br>
            Terms: Accepted
          </div>
          <div class="bg-white p-3 rounded border">
            <strong>Email Conflict Test:</strong><br>
            Email: existing@example.com<br>
            (Will show "Email already taken")
          </div>
          <div class="bg-white p-3 rounded border">
            <strong>Password Mismatch Test:</strong><br>
            Password: password123<br>
            Confirm: differentpassword
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Test control buttons
  document.getElementById('open-register-btn').addEventListener('click', function() {
    window.location.href = '<%= auth_test_register_path(show_register: true) %>';
  });
  
  document.getElementById('open-register-with-errors-btn').addEventListener('click', function() {
    const params = new URLSearchParams({
      show_register: 'true',
      'errors[first_name][]': 'First name is required',
      'errors[email][]': 'Please enter a valid email address',
      'errors[password][]': 'Password must be at least 8 characters',
      'errors[password_confirmation][]': 'Passwords do not match',
      'errors[terms_accepted][]': 'You must accept the terms of service'
    });
    window.location.href = '<%= auth_test_register_path %>?' + params.toString();
  });
  
  document.getElementById('open-register-with-data-btn').addEventListener('click', function() {
    const params = new URLSearchParams({
      show_register: 'true',
      'form_data[first_name]': 'John',
      'form_data[last_name]': 'Doe',
      'form_data[email]': 'john.doe@example.com'
    });
    window.location.href = '<%= auth_test_register_path %>?' + params.toString();
  });
</script>